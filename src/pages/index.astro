---
import Layout from "../layouts/Layout.astro";

// CONFIGURACIÓN: coloca aquí el número oficial de WhatsApp.
// Formato Perú: 51 + 9 dígitos, sin +, espacios ni guiones.
const whatsappNumber = "51987825739";
const whatsappMessage = "Deseo agendar una cita";
// WhatsApp decide si muestra la pantalla intermedia, la aplicación o el navegador.
const whatsappUrl = /^\d{10,15}$/.test(whatsappNumber)
  ? `https://api.whatsapp.com/send?phone=${whatsappNumber}&text=${encodeURIComponent(whatsappMessage)}`
  : "#footer-contact";

const mapUrl =
  "https://www.google.com/maps/search/?api=1&query=" +
  encodeURIComponent(
    "Dental Siloé, Av. Prol. Javier Prado Este, Ate, Lima Perú",
  );
const mapEmbedUrl =
  "https://www.google.com/maps?q=" +
  encodeURIComponent("Dental Siloé, Av. Prol. Javier Prado Este, Ate, Lima, Perú") +
  "&output=embed";
---

<Layout>
  <section id="inicio" class="hero-section relative overflow-hidden">
    <div class="hero-orb" aria-hidden="true"></div>
    <div class="page-container hero-layout relative grid items-center gap-8 lg:grid-cols-[1fr_1.08fr] lg:gap-12">
      <div class="hero-content relative z-10 max-w-[590px] order-2 lg:order-1">
        <p class="eyebrow">CONSULTORIO ODONTOLÓGICO EN ATE</p>
        <h1 class="mt-4 text-[clamp(2.55rem,5.1vw,5rem)] leading-[1.055] tracking-[-.045em] text-[#0b2f63]">
          Tu sonrisa merece una atención de <span class="relative text-[#096acb]">confianza<span class="hero-underline" aria-hidden="true"></span></span>
        </h1>
        <p class="mt-6 max-w-[530px] text-[1rem] leading-[1.75] text-[#425a73] sm:text-[1.13rem]">
          En Dental Siloé buscamos brindarte una atención odontológica cercana,
          clara y dedicada al cuidado de tu salud bucal en Ate.
        </p>
        <div class="hero-cta-row mt-7 flex flex-wrap gap-3.5">
          <a href={whatsappUrl} data-whatsapp-action class="button-primary">Agendar cita</a>
          <a href="#servicios" class="button-outline">Ver servicios</a>
        </div>
      </div>
      <div class="hero-photo-wrap relative order-1 lg:order-2">
        <div class="hero-photo relative overflow-hidden rounded-[1.65rem] border-[5px] border-white bg-[#d7edfa] shadow-[0_25px_65px_rgba(14,67,130,.16)] sm:rounded-[3rem] sm:border-[7px]">
          <picture>
            <source media="(max-width: 1023px)" srcset="/fotos/hero-mobile-propuesta-01.webp" type="image/webp" width="700" height="900" />
            <img src="/fotos/consultorio-hero.webp"
              alt="Imagen ilustrativa de atención odontológica con un profesional y una paciente"
              class="w-full object-cover object-center" width="1400" height="788" fetchpriority="high" decoding="async" />
          </picture>
        </div>
        <div class="mobile-experience-badge" aria-label="29 años de experiencia">
          <strong>29 años</strong>
          <span>de experiencia</span>
        </div>
      </div>
    </div>
  </section>

  <section class="experience-section" aria-labelledby="trayectoria-title">
    <div class="experience-aura experience-aura-left" aria-hidden="true"></div>
    <div class="experience-aura experience-aura-right" aria-hidden="true"></div>
    <div class="page-container experience-content">
      <p class="eyebrow experience-eyebrow">NUESTRA TRAYECTORIA</p>
      <h2 id="trayectoria-title" class="experience-title">
        <span class="experience-highlight">29 años de experiencia</span>
        <span class="experience-rest">cuidando sonrisas con cercanía y dedicación.</span>
      </h2>
      <span class="experience-divider" aria-hidden="true"></span>
      <p class="experience-caption">Comprometidos con tu sonrisa en cada visita.</p>
    </div>
  </section>

  <section id="servicios" class="section-space bg-[#f7fbff]">
    <div class="page-container">
      <div class="section-heading mx-auto max-w-3xl text-center md:mx-0 md:text-left">
        <p class="eyebrow">NUESTROS SERVICIOS</p>
        <h2 class="mt-3">Cuidamos tu <span>sonrisa</span></h2>
        <p>
          Conoce algunas de las áreas de atención que puedes consultar con
          nuestro equipo. Confirma los tratamientos disponibles al solicitar tu
          cita.
        </p>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-3 lg:gap-7">
        <article class="service-card">
          <img class="service-photo" src="/evaluacion-optimizado.webp" alt="Paciente recibiendo una revisión odontológica" loading="lazy" width="783" height="391" />
          <div class="service-card-body">
            <h3>Evaluación odontológica</h3>
            <p>Un primer acercamiento para conocer tus necesidades de salud oral y recibir orientación sobre tu atención.</p>
          </div>
        </article>
        <article class="service-card">
          <img class="service-photo" src="/image-1-optimizado.webp" alt="Profesional odontológica conversando con una paciente" loading="lazy" width="650" height="434" />
          <div class="service-card-body">
            <h3>Atención general</h3>
            <p>Un espacio dedicado al cuidado de tu sonrisa, con atención cercana y explicaciones claras.</p>
          </div>
        </article>
        <article class="service-card">
          <img class="service-photo" src="/atencion-optimizado.webp" alt="Personal odontológico junto a una paciente en un consultorio" loading="lazy" width="1080" height="606" />
          <div class="service-card-body">
            <h3>Prevención y cuidado</h3>
            <p>Orientación para adoptar hábitos de higiene oral y mantener una sonrisa saludable.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section id="rehabilitacion" class="section-space rehab-section bg-white">
    <div class="page-container">
      <div class="section-heading mx-auto max-w-3xl text-center">
        <p class="eyebrow">REHABILITACIÓN ORAL</p>
        <h2 class="mt-3">Recupera tu <span>sonrisa</span></h2>
        <p>
          Realizamos rehabilitación oral para devolver funcionalidad, comodidad
          y armonía a tu sonrisa. Evaluamos cada caso de forma personalizada
          para mejorar la mordida, la estética dental y la seguridad al sonreír.
        </p>
      </div>
      <figure class="gallery-feature rehab-feature mt-8 sm:mt-10">
        <img
          src="/antes-y-despues-rehabilitacion-oral.webp"
          srcset="/antes-y-despues-rehabilitacion-oral-640.webp 640w, /antes-y-despues-rehabilitacion-oral.webp 1000w"
          sizes="(max-width: 700px) calc(100vw - 38px), 641px"
          alt="Comparación visual de antes y después en un tratamiento de rehabilitación oral"
          loading="lazy"
          width="1000"
          height="671"
        />
        
      </figure>
    </div>
  </section>

  <section id="nosotros" class="section-space overflow-hidden bg-white">
    <div class="page-container grid items-center gap-9 lg:grid-cols-[.94fr_1.06fr] lg:gap-16">
      <div class="relative mx-auto w-full max-w-[510px] lg:mx-0">
        <div class="absolute -left-5 -top-5 -z-0 h-[95%] w-[94%] rounded-[2.5rem] bg-[#d7f1ff]"></div>
        <img
          src="/fotos/hero-mobile.webp"
          srcset="/fotos/hero-mobile-480.webp 480w, /fotos/hero-mobile.webp 655w"
          sizes="(max-width: 540px) calc(100vw - 38px), 510px"
          alt="Entrada real de Dental Siloé con su señalización"
          loading="lazy"
          decoding="async"
          width="655" height="879"
          class="relative h-[400px] w-full rounded-[2.1rem] object-content object-center shadow-[0_18px_48px_rgba(9,56,115,.11)] sm:h-[590px]"
        />
      </div>
      <div class="section-heading max-w-[600px]">
        <p class="eyebrow">SOBRE NOSOTROS</p>
        <h2 class="mt-4">Conoce <span>Dental Siloé</span></h2>
        <p class="mt-6">
          Somos un consultorio odontológico ubicado en Ate. Queremos que cada
          persona que nos visite encuentre un espacio donde pueda recibir
          información clara y un trato cercano durante su atención.
        </p>
        <div class="mt-9 grid gap-5 sm:grid-cols-2">
          <div class="benefit">
            <div class="benefit-icon" aria-hidden="true">♡</div><div>
              <h3>Atención cercana</h3><p>
                Escuchamos tus consultas y necesidades.
              </p>
            </div>
          </div>
          <div class="benefit">
            <div class="benefit-icon" aria-hidden="true">✦</div><div>
              <h3>Información clara</h3><p>
                Orientación comprensible para cada paciente.
              </p>
            </div>
          </div>
          <div class="benefit sm:col-span-2">
            <div class="benefit-icon" aria-hidden="true">⌖</div><div>
              <h3>Estamos en Ate</h3><p>
                Encuéntranos en la avenida Prolongación Javier Prado Este.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="instalaciones" class="section-space bg-[#f0f9ff]">
    <div class="page-container">
      <div class="section-heading mx-auto max-w-3xl text-center md:mx-0 md:text-left">
        <p class="eyebrow">NUESTRO ESPACIO</p>
        <h2 class="mt-3">Nuestras <span>instalaciones</span></h2>
        <p>
          Un vistazo real al espacio donde te recibimos. Las fotografías
          corresponden a nuestro consultorio.
        </p>
      </div>
      <figure class="gallery-feature mt-8 sm:mt-10">
        <img
          src="/fotos/equipo-dental.webp"
          alt="Fotografía real del sillón y los equipos odontológicos de Dental Siloé"
          loading="lazy"
          width="1387"
          height="720"
        />
        <figcaption>Conoce nuestro espacio de atención</figcaption>
      </figure>
    </div>
  </section>

  <section id="ubicacion" class="location-section" aria-labelledby="location-title">
    <div class="page-container">
      <div class="location-heading">
        <p class="eyebrow">ENCUÉNTRANOS</p>
        <h2 id="location-title">¡Ven a <span>visitarnos!</span></h2>
        <p>Estamos en Av. Prol. Javier Prado Este, Ate, Lima. Revisa nuestra ubicación en el mapa.</p>
      </div>
      <div class="map-frame">
        <iframe
          src={mapEmbedUrl}
          title="Mapa de Google Maps para buscar Dental Siloé en Ate, Lima"
          width="100%"
          height="450"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
      <div class="location-actions">
        <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="button-primary">Abrir en Google Maps</a>
      </div>
    </div>
  </section>
  <footer id="footer-contact" class="site-footer bg-[#082e61] py-10 text-[#c6def3]">
    <div class="page-container footer-grid">
      <div class="footer-brand-block">
        <p class="footer-copy">© {new Date().getFullYear()} Dental Siloé. Todos los derechos reservados.</p>
        <p class="footer-copy">Atención odontológica en Ate, Lima.</p>
      </div>

      <div class="footer-info-block">
        <p class="footer-title">Horario de atención</p>
        <p>Lunes a viernes: 9 a. m. – 8 p. m.</p>
        <p>Sábados: 9 a. m. – 12 p. m.</p>
      </div>

      <div class="footer-info-block">
        <p class="footer-title">Ubicación</p>
        <p>Av. Prol. Javier Prado Este</p>
        <p>Ate 15498, Lima, Perú</p>
      </div>
    </div>
  </footer>

  <a
    id="whatsapp-launcher"
    href={whatsappUrl}
    target={whatsappUrl.startsWith("https://") ? "_blank" : undefined}
    rel={whatsappUrl.startsWith("https://") ? "noopener noreferrer" : undefined}
    aria-label="Enviar un mensaje a Dental Siloé por WhatsApp para agendar una cita"
    class="whatsapp-launcher"
    title="Agendar cita"
    data-whatsapp-phone={whatsappNumber}
    data-whatsapp-message={whatsappMessage}
  >
    <img class="whatsapp-symbol" src="/whatsapp-logo-optimizado.webp" alt="" width="116" height="116" decoding="async" />
  </a>
  <script>
    // Unifica los botones de cita sin saltarse la pantalla intermedia de WhatsApp.
    const launcher = document.querySelector<HTMLAnchorElement>("#whatsapp-launcher");
    const number = launcher?.dataset.whatsappPhone ?? "";
    const message = launcher?.dataset.whatsappMessage ?? "";
    if (/^\d{10,15}$/.test(number)) {
      const url = `https://api.whatsapp.com/send?phone=${number}&text=${encodeURIComponent(message)}`;
      document.querySelectorAll<HTMLAnchorElement>("[data-whatsapp-action], #whatsapp-launcher")
        .forEach((link) => {
          link.href = url;
          link.target = "_blank";
          link.rel = "noopener noreferrer";
        });
    }
  </script>
</Layout>
