---
import Layout from "../layouts/Layout.astro";
const hours = [
  ["Lunes", "9 a. m. – 8 p. m."],
  ["Martes", "9 a. m. – 8 p. m."],
  ["Miércoles", "9 a. m. – 8 p. m."],
  ["Jueves", "9 a. m. – 8 p. m."],
  ["Viernes", "9 a. m. – 8 p. m."],
  ["Sábado", "9 a. m. – 12 p. m."],
  ["Domingo", "Cerrado"],
];
const mapUrl =
  "https://www.google.com/maps/search/?api=1&query=" +
  encodeURIComponent(
    "Dental Siloé, Av. Prol. Javier Prado Este, Ate, Lima Perú",
  );
---

<Layout>
  <section id="inicio" class="hero-section relative overflow-hidden">
    <div class="hero-orb" aria-hidden="true"></div>
    <div class="page-container hero-layout relative grid items-center gap-8 lg:grid-cols-[1fr_1.08fr] lg:gap-12">
      <div class="hero-content relative z-10 max-w-[590px] order-2 lg:order-1">
        <p class="eyebrow">CONSULTORIO ODONTOLÓGICO EN ATE</p>
        <h1 class="mt-4 text-[clamp(2.55rem,5.1vw,5rem)] leading-[1.055] tracking-[-.045em] text-[#0b2f63]">
          Tu sonrisa merece una atención de <span class="relative text-[#096acb]">confianza<span class="hero-underline" aria-hidden="true"></span></span>
        </h1>
        <p class="mt-6 max-w-[530px] text-[1rem] leading-[1.75] text-[#425a73] sm:text-[1.13rem]">
          En Dental Siloé buscamos brindarte una atención odontológica cercana,
          clara y dedicada al cuidado de tu salud bucal en Ate.
        </p>
        <div class="mt-7 flex flex-wrap gap-3.5">
          <a href="#contacto" class="button-primary">Agendar cita <span aria-hidden="true">↗</span></a>
          <a href="#servicios" class="button-outline">Ver servicios <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="hero-photo-wrap relative order-1 lg:order-2">
        <div class="hero-photo relative overflow-hidden rounded-[1.65rem] border-[5px] border-white bg-[#d7edfa] shadow-[0_25px_65px_rgba(14,67,130,.16)] sm:rounded-[3rem] sm:border-[7px]">
          <img src="/fotos/consultorio-hero.webp"
            alt="Fotografía real del consultorio Dental Siloé y su equipo odontológico"
            class="w-full object-cover object-center" width="1327" height="720" fetchpriority="high" decoding="async" />
        </div>
        <div class="hero-note absolute -bottom-3 right-2 rounded-[1.1rem] bg-white px-4 py-3 text-right shadow-[0_10px_32px_rgba(6,52,109,.14)] sm:-right-3 sm:bottom-8 sm:px-6 sm:py-4">
          <span class="block text-sm font-extrabold leading-tight text-[#0b4f9f] sm:text-lg">Tu sonrisa es<br />nuestra inspiración</span>
          <span class="mt-1 block text-[.65rem] font-semibold tracking-wide text-[#b65105] sm:text-xs">DENTAL SILOÉ · ATE</span>
        </div>
      </div>
    </div>
  </section>

  <section id="servicios" class="section-space bg-[#f7fbff]">
    <div class="page-container">
      <div class="section-heading mx-auto max-w-3xl text-center md:mx-0 md:text-left">
        <p class="eyebrow">NUESTROS SERVICIOS</p>
        <h2 class="mt-3">Cuidamos tu <span>sonrisa</span></h2>
        <p>
          Conoce algunas de las áreas de atención que puedes consultar con
          nuestro equipo. Confirma los tratamientos disponibles al solicitar tu
          cita.
        </p>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-3 lg:gap-7">
        <article class="service-card">
          <img class="service-photo" src="/evaluacion.jpg" alt="Paciente recibiendo una revisión odontológica" loading="lazy" width="783" height="391" />
          <div class="service-card-body">
            <h3>Evaluación odontológica</h3>
            <p>Un primer acercamiento para conocer tus necesidades de salud oral y recibir orientación sobre tu atención.</p>
          </div>
        </article>
        <article class="service-card">
          <img class="service-photo" src="/image-1.jpg" alt="Profesional odontológica conversando con una paciente" loading="lazy" width="1080" height="720" />
          <div class="service-card-body">
            <h3>Atención general</h3>
            <p>Un espacio dedicado al cuidado de tu sonrisa, con atención cercana y explicaciones claras.</p>
          </div>
        </article>
        <article class="service-card">
          <img class="service-photo" src="/atencion.jpg" alt="Personal odontológico junto a una paciente en un consultorio" loading="lazy" width="1080" height="606" />
          <div class="service-card-body">
            <h3>Prevención y cuidado</h3>
            <p>Orientación para adoptar hábitos de higiene oral y mantener una sonrisa saludable.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section id="nosotros" class="section-space overflow-hidden bg-white">
    <div
      class="page-container grid items-center gap-9 lg:grid-cols-[.94fr_1.06fr] lg:gap-16"
    >
      <div class="relative mx-auto w-full max-w-[510px] lg:mx-0">
        <div
          class="absolute -left-5 -top-5 -z-0 h-[95%] w-[94%] rounded-[2.5rem] bg-[#d7f1ff]"
        >
        </div>
        <img
          src="/fotos/entrada-consultorio.webp"
          alt="Entrada real de Dental Siloé con su señalización"
          loading="lazy"
          class="relative h-[400px] w-full rounded-[2.1rem] object-cover object-center shadow-[0_18px_48px_rgba(9,56,115,.11)] sm:h-[490px]"
        />
      </div>
      <div class="section-heading max-w-[600px]">
        <p class="eyebrow">SOBRE NOSOTROS</p>
        <h2 class="mt-4">Conoce <span>Dental Siloé</span></h2>
        <p class="mt-6">
          Somos un consultorio odontológico ubicado en Ate. Queremos que cada
          persona que nos visite encuentre un espacio donde pueda recibir
          información clara y un trato cercano durante su atención.
        </p>
        <div class="mt-9 grid gap-5 sm:grid-cols-2">
          <div class="benefit">
            <div class="benefit-icon" aria-hidden="true">♡</div><div>
              <h3>Atención cercana</h3><p>
                Escuchamos tus consultas y necesidades.
              </p>
            </div>
          </div>
          <div class="benefit">
            <div class="benefit-icon" aria-hidden="true">✦</div><div>
              <h3>Información clara</h3><p>
                Orientación comprensible para cada paciente.
              </p>
            </div>
          </div>
          <div class="benefit sm:col-span-2">
            <div class="benefit-icon" aria-hidden="true">⌖</div><div>
              <h3>Estamos en Ate</h3><p>
                Encuéntranos en la avenida Prolongación Javier Prado Este.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="instalaciones" class="section-space bg-[#f0f9ff]">
    <div class="page-container">
      <div class="section-heading mx-auto max-w-3xl text-center md:mx-0 md:text-left">
        <p class="eyebrow">NUESTRO ESPACIO</p>
        <h2 class="mt-3">Nuestras <span>instalaciones</span></h2>
        <p>
          Un vistazo real al espacio donde te recibimos. Las fotografías
          corresponden a nuestro consultorio.
        </p>
      </div>
      <figure class="gallery-feature mt-8 sm:mt-10">
        <img
          src="/fotos/equipo-dental.webp"
          alt="Fotografía real del sillón y los equipos odontológicos de Dental Siloé"
          loading="lazy"
          width="1387"
          height="720"
        />
        <figcaption>Conoce nuestro espacio de atención</figcaption>
      </figure>
    </div>
  </section>

  <section id="contacto" class="section-space bg-[#e8f5ff]">
    <div class="page-container">
      <div class="section-heading mx-auto max-w-3xl text-center md:mx-0 md:text-left">
        <p class="eyebrow">CONTÁCTANOS</p><h2 class="mt-3">
          Estamos <span>en Ate</span>
        </h2>
        <p>
          Visítanos o consulta cómo coordinar tu próxima cita. Estaremos
          encantados de recibirte.
        </p>
      </div>
      <div class="mt-8 grid items-stretch gap-6 lg:grid-cols-3">
        <div class="contact-card flex flex-col">
          <span class="contact-icon" aria-hidden="true">⌖</span><h3>
            Nuestra ubicación
          </h3><address class="mt-3 not-italic leading-7 text-[#52657a]">
            Av. Prol. Javier Prado Este<br />Ate 15498, Lima, Perú
          </address><p class="mt-3 text-sm leading-6 text-[#63778c]">
            Consulta la ubicación exacta antes de visitarnos.
          </p><a
            class="mt-auto inline-flex pt-6 font-bold text-[#0964c0] hover:underline"
            href={mapUrl}
            target="_blank"
            rel="noopener noreferrer">Consultar en Google Maps ↗</a>
        </div>
        <div class="contact-card">
          <span class="contact-icon" aria-hidden="true">◷</span><h3>
            Horarios de atención
          </h3><dl class="mt-4 space-y-2.5 text-sm">
            {
              hours.map(([day, time]) => (
                <div class="flex justify-between gap-4 border-b border-[#e5edf5] pb-2">
                  <>
                    <dt class="font-medium text-[#4b6480]">{day}</dt>
                    <dd class="text-right font-bold text-[#123964]">{time}</dd>
                  </>
                </div>
              ))
            }
          </dl>
        </div>
        <div class="contact-card flex flex-col">
          <span class="contact-icon" aria-hidden="true">↗</span><h3>
            ¿Cómo llegar?
          </h3><p class="mt-3 leading-7 text-[#52657a]">
            Puedes buscar Dental Siloé en Google Maps para consultar la ruta
            desde tu ubicación.
          </p><div
            class="map-art mt-6 flex min-h-[155px] items-center justify-center rounded-2xl border border-[#d9eaf7] bg-[#f2f8fc]"
            aria-hidden="true"
          >
            <span
              class="rounded-full bg-white px-5 py-3 text-base font-bold text-[#14569d] shadow-sm"
              >⌖ Dental Siloé · Ate</span>
          </div><a
            class="button-map mt-6"
            href={mapUrl}
            target="_blank"
            rel="noopener noreferrer">Abrir Google Maps ↗</a>
        </div>
      </div>
    </div>
  </section>
  <footer class="bg-[#082e61] py-8 text-[#c6def3]">
    <div
      class="page-container flex flex-col items-start justify-between gap-4 text-sm sm:flex-row sm:items-center"
    >
      <p>
        © {new Date().getFullYear()} Dental Siloé. Todos los derechos reservados.
      </p><p>Atención odontológica en Ate, Lima.</p>
    </div>
  </footer>

  <!-- Se muestra el acceso de WhatsApp, pero no se inventa un número sin confirmar. -->
  <button
    id="whatsapp-launcher"
    type="button"
    aria-label="Información de contacto por WhatsApp"
    aria-expanded="false"
    aria-controls="whatsapp-notice"
    class="whatsapp-launcher"
    title="WhatsApp · número por confirmar"
  >
    <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"
      ><path
        d="M16.01 3.2A12.72 12.72 0 0 0 5.05 22.4L3.2 29l6.78-1.78A12.8 12.8 0 1 0 16.01 3.2Zm0 23.23c-2 0-3.95-.54-5.64-1.56l-.41-.25-4.02 1.05 1.07-3.92-.27-.42a10.47 10.47 0 1 1 9.27 5.1Zm5.76-7.87c-.31-.15-1.85-.91-2.13-1.02-.29-.1-.5-.15-.71.16-.21.31-.81 1.02-.99 1.23-.18.21-.37.23-.68.08-.31-.16-1.32-.49-2.52-1.55-.94-.84-1.57-1.87-1.75-2.19-.19-.31-.02-.48.14-.64.14-.14.31-.37.47-.55.16-.18.21-.31.31-.52.11-.21.05-.39-.03-.55-.08-.16-.71-1.72-.98-2.35-.25-.61-.5-.52-.71-.53l-.6-.01c-.21 0-.55.08-.84.39s-1.1 1.08-1.1 2.64 1.13 3.07 1.29 3.28 2.69 4.12 6.51 5.78c.91.39 1.62.62 2.18.79.92.29 1.75.25 2.41.15.74-.11 2.28-.93 2.6-1.83.32-.91.32-1.68.22-1.83-.1-.16-.29-.24-.6-.39Z"
      ></path></svg
    >
  </button>
  <div id="whatsapp-notice" class="whatsapp-notice hidden" role="status">
    <strong>WhatsApp de Dental Siloé</strong><p>
      Estamos esperando la confirmación del número oficial. Mientras tanto,
      puedes consultar nuestra ubicación y horarios aquí.
    </p><a href="#contacto">Ver contacto →</a>
  </div>
  <script>
    const wa = document.querySelector<HTMLButtonElement>("#whatsapp-launcher");
    const panel = document.querySelector<HTMLElement>("#whatsapp-notice");
    wa?.addEventListener("click", () => {
      const opened = !panel?.classList.contains("hidden");
      panel?.classList.toggle("hidden", opened);
      wa.setAttribute("aria-expanded", String(!opened));
    });
    panel?.querySelector("a")?.addEventListener("click", () => {
      panel.classList.add("hidden");
      wa?.setAttribute("aria-expanded", "false");
    });
  </script>
</Layout>
